# ---------------------------------------------------------------------------
# ExamPrep environment configuration (copy to .env and fill in values)
# Never commit a real .env file or a real API key.
# ---------------------------------------------------------------------------

# Self-hosted FreeLLMAPI OpenAI-compatible router (https://github.com/tashfeenahmed/freellmapi).
# Used when running Spring Boot directly on your host (`./mvnw spring-boot:run`).
# Note: Docker Compose automatically uses http://host.docker.internal:3001/v1 inside the container
# (override with FREELLMAPI_DOCKER_BASE_URL only if FreeLLMAPI runs on another host/port).
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Unified proxy key from your FreeLLMAPI dashboard (Keys -> Agents, e.g. freellmapi-...).
# The application starts without it, but AI features will report a configuration error.
FREELLMAPI_API_KEY=freellmapi-7bce593dd8aaed880e5c75ee4236310433aa169f351f4baf

# Routing mode or model ID ("auto", "auto:smart", "auto:fast", "auto:reliable", "auto:balanced",
# "fusion", or a pinned catalog model ID).
FREELLMAPI_MODEL=auto

# Per-request timeouts (seconds), transient retry count, and max concurrent AI requests.
FREELLMAPI_CONNECT_TIMEOUT_SECONDS=10
FREELLMAPI_TIMEOUT_SECONDS=180
FREELLMAPI_TUTOR_TIMEOUT_SECONDS=60
FREELLMAPI_MAX_RETRIES=2
FREELLMAPI_MAX_CONCURRENCY=3

# Optional reasoning effort hint forwarded to providers that support it (low, medium or high).
FREELLMAPI_REASONING_EFFORT=low

# PostgreSQL connection (used by the Spring Boot application).
# When the database comes from compose.yaml it is published on port 5433 (DB_PORT), not 5432, so it
# never clashes with a Postgres server already running on the default port.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/examprep
SPRING_DATASOURCE_USERNAME=examprep
SPRING_DATASOURCE_PASSWORD=change-me

# Docker Compose database credentials (consumed by the postgres service)
POSTGRES_DB=examprep
POSTGRES_USER=examprep
POSTGRES_PASSWORD=change-me
# Host port the Compose database is published on.
DB_PORT=5433

# Private directory where uploaded documents are stored. Must not be web-served.
APP_STORAGE_LOCATION=./data/uploads

# Maximum accepted upload size, in megabytes.
APP_MAX_UPLOAD_SIZE_MB=25

# HTTP port of the web application.
SERVER_PORT=8080
