# Copy this file to .env and fill in the values. Never commit .env.

# Required: password for the PostgreSQL container and the application user.
POSTGRES_PASSWORD=change-me-before-production

# Required for AI features. Create a key in Google AI Studio and paste it here.
# The application starts without a key; generation and tutor requests then fail
# with a clear configuration message instead of calling the API.
GOOGLE_API_KEY=

# Optional Gemini settings.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional application settings.
APP_MAX_UPLOAD_SIZE_MB=25
APP_STALE_JOB_MINUTES=30
SERVER_PORT=8080

# Only needed when the application runs outside Docker Compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/examprep
# SPRING_DATASOURCE_USERNAME=examprep
# SPRING_DATASOURCE_PASSWORD=change-me-before-production
# APP_STORAGE_LOCATION=./data/uploads
