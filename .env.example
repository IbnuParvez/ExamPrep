# ---------------------------------------------------------------------------
# ExamPrep environment configuration (copy to .env and fill in values)
# Never commit a real .env file or a real API key.
# ---------------------------------------------------------------------------

# Google Gemini Developer API key. Create one at https://aistudio.google.com/apikey
# The application starts without it, but AI features will report a configuration error.
GOOGLE_API_KEY=

# Gemini model used for every AI operation. Must be a model available to your key.
GEMINI_MODEL=gemini-3.8-flash

# Gemini request timeout (seconds) for a single attempt, and retries for transient failures.
# A retry is only started if it still fits inside GEMINI_TIMEOUT_SECONDS of wall-clock time, so a
# hung request is never multiplied by the retry count.
GEMINI_TIMEOUT_SECONDS=240
GEMINI_MAX_RETRIES=2

# Base backoff before a retry, in milliseconds; it doubles after each further failed attempt.
# Gemini rate limits are per-minute windows, so very short backoffs only burn quota.
GEMINI_RETRY_BASE_DELAY_MS=5000

# Upper bound for one answer, including Gemini's internal "thinking" tokens. 65536 is the maximum
# for gemini-3.8-flash; lower it for a model with a smaller output limit.
GEMINI_MAX_OUTPUT_TOKENS=65536

# Gemini thinking effort: low, medium or high. Low leaves more of the output budget for the answer.
GEMINI_THINKING_LEVEL=low

# PostgreSQL connection (used by the Spring Boot application).
# When the database comes from compose.yaml it is published on port 5433 (DB_PORT), not 5432, so it
# never clashes with a Postgres server already running on the default port.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/examprep
SPRING_DATASOURCE_USERNAME=examprep
SPRING_DATASOURCE_PASSWORD=change-me

# Docker Compose database credentials (consumed by the postgres service)
POSTGRES_DB=examprep
POSTGRES_USER=examprep
POSTGRES_PASSWORD=change-me
# Host port the Compose database is published on.
DB_PORT=5433

# Private directory where uploaded documents are stored. Must not be web-served.
APP_STORAGE_LOCATION=./data/uploads

# Maximum accepted upload size, in megabytes.
APP_MAX_UPLOAD_SIZE_MB=25

# HTTP port of the web application.
SERVER_PORT=8080
